# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-debug.log*

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files and credentials
.env
.env*.local
*.keystore
google-services.json
GoogleService-Info.plist
credentials.json
.claude/settings.local.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
# Gradle output of the local Expo modules (written by pnpm android)
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/

# generated data and local caches
.cache/
assets/catalog.db
agent-tools/

# RingsDB payloads outside data/; data/raw/ringsdb is the committed snapshot data build reads
**/ringsdb/**
!data/raw/ringsdb/**

# booklet PDFs, and the map pnpm assets booklets writes beside them
*.pdf
assets/booklets/

# card images; shell icons stay
*.jpg
# what assets scans packed each picture from
assets/scans/.packed.json
*.jpeg
*.webp
*.png
!assets/images/*.png
!assets/images/**/*.png
!assets/expo.icon/**/*.png
# the README hero's app icon
!.github/readme/*.png
# game icons: the raw DragnCards token art and card backs data build reads, and the built icons the app requires
!data/raw/icons/**/*.png
!assets/icons/*.png
!data/raw/icons/dragncards/cardbacks/*.jpg
!assets/icons/*Back.jpg

# agent drafts
.agent/
.claude/worktrees/
