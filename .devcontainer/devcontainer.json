{
  "name": "middle-earth-player",
  // Pinned by digest, so the image cannot change under the tag. To move it, read the tag's digest
  // (docker buildx imagetools inspect mcr.microsoft.com/devcontainers/javascript-node:22) and change it here.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22@sha256:cd275c65a4b27a7790de915909be221d585fe645cf976cb1113b1ea9f62610d3",
  "hostRequirements": {
    "cpus": 4
  },
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "onCreateCommand": "sudo corepack enable pnpm && pnpm install --frozen-lockfile",
  "postCreateCommand": "pnpm assets catalog || echo 'assets catalog failed; run it again before pnpm web' >&2",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Metro",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "vitest.explorer"]
    }
  }
}
