  "scripts": {
    "start": "pnpm assets --optional && expo start",
    "android": "pnpm assets && expo run:android",
    "android:usb": "adb reverse tcp:8081 tcp:8081 && REACT_NATIVE_PACKAGER_HOSTNAME=localhost pnpm android",
    "ios": "pnpm assets && expo run:ios",
    "web": "pnpm assets catalog && pnpm assets canvaskit && pnpm assets pdfjs && expo start --web",
    "lint": "oxlint",
    "typecheck": "tsrs -p . --noEmit",
    "test": "node scripts/cli.ts test",
    "assets": "node scripts/cli.ts assets",
    "data": "node scripts/cli.ts data",
    "effects": "node scripts/cli.ts effects",
    "scenario": "node scripts/cli.ts scenario",
    "doc": "node scripts/cli.ts doc",
    "game": "node scripts/cli.ts game",
    "browser": "node scripts/cli.ts browser",
    "desktop": "node scripts/cli.ts desktop",
    "release": "node scripts/cli.ts release",
    "move": "node scripts/tools/move.ts",
    "commit:check": "node scripts/git/commit-message.ts",
    "eas-build-post-install": "pnpm assets",
    "prepare": "node scripts/git/commit-message.ts --install --quiet"
  },
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.18"
  }
