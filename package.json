{
  "name": "middle-earth-lcg",
  "main": "expo-router/entry",
  "version": "0.0.0",
  "description": "An offline app for playing The Lord of the Rings: The Card Game solo. Fan-made, not affiliated with Fantasy Flight Games.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-jmnz/middle-earth-lcg.git"
  },
  "homepage": "https://github.com/j-jmnz/middle-earth-lcg#readme",
  "bugs": "https://github.com/j-jmnz/middle-earth-lcg/issues",
  "dependencies": {
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "booklet-pdf": "file:./modules/booklet-pdf",
    "drizzle-orm": "^0.45.4",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "image-backup-exclusion": "file:./modules/image-backup-exclusion",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "7.29.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "~19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "better-sqlite3": "^13.0.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "jsonc-parser": "^3.3.1",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "sharp": "0.34.3",
    "tailwindcss": "3.4.17",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "pnpm catalog:build && pnpm booklets:pack --optional && pnpm scans:pack --optional && expo start",
    "android": "pnpm catalog:build && pnpm booklets:pack && pnpm scans:pack && expo run:android",
    "android:usb": "adb reverse tcp:8081 tcp:8081 && REACT_NATIVE_PACKAGER_HOSTNAME=localhost pnpm android",
    "ios": "pnpm catalog:build && pnpm booklets:pack && pnpm scans:pack && expo run:ios",
    "web": "pnpm catalog:build && expo start --web",
    "lint": "oxlint",
    "test": "vitest run",
    "test:fast": "VITEST_FAST=1 vitest run",
    "test:changed": "vitest run --changed",
    "a11y:web": "pnpm catalog:build && node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/checks/a11y-web.ts",
    "typecheck": "tsrs -p . --noEmit",
    "catalog:build": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build/catalog.ts",
    "eas-build-post-install": "pnpm catalog:build && pnpm scans:pack && pnpm booklets:pack",
    "scans:pack": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build/pack-scans.ts",
    "booklets:pack": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build/pack-booklets.ts",
    "data:sync": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/sync.ts",
    "data:build": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/build.ts",
    "effects:draft": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/effects/draft.ts",
    "effects:open": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/effects/open.ts",
    "data:check": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/check.ts",
    "data:query": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/query.ts",
    "docs:index": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/docs/index.ts",
    "docs:section": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/docs/index.ts section",
    "move": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/tools/move.ts",
    "test:scenario": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/tools/test-scenario.ts",
    "scenario:new": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/tools/scenario-new.ts",
    "release:plan": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/release/plan.ts",
    "release:source": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/release/sideload-source.ts",
    "commit:check": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/git/commit-message.ts",
    "prepare": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/git/commit-message.ts --install --quiet"
  },
  "private": true,
  "packageManager": "pnpm@10.34.1"
}
