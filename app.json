{
  "expo": {
    "name": "Middle Earth LCG",
    "slug": "middle-earth-lcg",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "middleearthlcg",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.middleearth.lcg"
    },
    "android": {
      "package": "com.middleearth.lcg",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/screens/routes",
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/MarcellusSC-Regular.ttf",
              "./assets/fonts/BarlowSemiCondensed-Regular.ttf",
              "./assets/fonts/BarlowSemiCondensed-SemiBold.ttf",
              "./assets/fonts/BarlowSemiCondensed-Bold.ttf",
              "./assets/fonts/BarlowSemiCondensed-Italic.ttf"
            ]
          },
          "android": {
            "fonts": [
              "./assets/fonts/MarcellusSC-Regular.ttf",
              {
                "fontFamily": "Barlow Semi Condensed",
                "fontDefinitions": [
                  { "path": "./assets/fonts/BarlowSemiCondensed-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/BarlowSemiCondensed-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/BarlowSemiCondensed-Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/BarlowSemiCondensed-Italic.ttf", "weight": 400, "style": "italic" }
                ]
              }
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "./plugins/with-script-sandboxing-off.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
