  {"code":"12147","name":"The Coast of Umbar","type":"quest","typeName":"Quest","sphere":null,"traits":[],"isUnique":false,"cost":null,"deckLimit":null,"threat":null,"willpower":null,"attack":null,"defense":null,"health":null,"questPoints":15,"victory":null,"engagementCost":null,"quantity":1,"easyQuantity":0,"encounterSet":"Coast of Umbar","stage":"1A","keywords":{"sailing":true},"timings":["setup","constant","constant"],"text":"Setup: Shuffle the Coast of Umbar, Corsair Raiders, Stormy Weather, Umbar Fleet, and Voyage Across Belegaer encounter sets into one encounter deck and make it the active encounter deck. Set The City of Corsairs encounter set aside, as an inactive second encounter deck. Prepare the Corsair deck. Players prepare their fleet. Add the Stormcaller to the staging area. Add 1 copy of Southern Belfalas to the staging area (2 instead if there are 3 or 4 players in the game). Shuffle the encounter deck.","shadowText":null,"campaignKind":null,"burdenSet":null,"backType":null,"hasErrata":false,"errata":null,"imagesrc":null,"deckLegal":false,"back":{"name":null,"text":"Sailing.\nProgress cannot be placed on The Coast of Umbar if the players are off-course (Cloud, Rain, or Storm).\nIf the Stormcaller is destroyed (or if this stage has 15 or more progress on it), advance to stage 2.","questPoints":15,"stage":"1B"},"printings":[{"pack":"CoC","number":147,"hobSlug":"The-Coast-of-Umbar-TCoC","octgnGuid":"c79ff551-f816-4106-9c55-e22d175e544c","imageUrls":["https://dragncards-lotrlcg.s3.amazonaws.com/cards/English/c79ff551-f816-4106-9c55-e22d175e544c.B.jpg","https://s3.amazonaws.com/hallofbeorn-resources/Images/Cards/The-City-of-Corsairs/The-Coast-of-Umbar-1A.jpg","https://s3.amazonaws.com/hallofbeorn-resources/Images/Cards/The-City-of-Corsairs/The-Coast-of-Umbar-1B.jpg"]}]},
