  {"code":"22024","name":"The Burglar's Turn","type":"contract","typeName":"Contract","sphere":"neutral","traits":[],"isUnique":false,"cost":null,"deckLimit":1,"threat":null,"willpower":null,"attack":null,"defense":null,"health":null,"questPoints":null,"victory":null,"engagementCost":null,"quantity":1,"easyQuantity":null,"encounterSet":null,"stage":null,"keywords":{},"timings":["constant","setup","constant","forced","forced"],"text":"<b>Side A</b>\r\nYou cannot include attachments in your deck. \r\n<b>Setup:</b> Choose 14 different <b><i>Item</i></b> or <b><i>Artifact</i></b> attachments from your collection and shuffle them together. This is your loot deck. Flip this card over and place your loot deck facedown under it.\r\n\r\n<b>Side B</b>\r\nThe active location gets +1 quest point for each attachment attached to it.\r\n<b>Forced:</b> After you travel to a location, attach the top card of your loot deck faceup to that location as a guarded objective. If that attachment has the guarded X keyword, ignore it.\r\n<b>Forced:</b> When the active location is explored, you may put each guarded attachment on that location into play at no cost, or add it to your hand.","shadowText":null,"campaignKind":null,"burdenSet":null,"backType":null,"hasErrata":false,"errata":null,"imagesrc":"/bundles/cards/22024.png","deckLegal":true,"back":{"name":null,"text":"The active location gets +1 quest point for each attachment attached to it.\nForced: After you travel to a location, attach the top card of your loot deck faceup to that location as a guarded objective. If that attachment has the guarded X keyword, ignore it.\nForced: When the active location is explored, you may put each guarded attachment on that location into play at no cost, or add it to your hand.","questPoints":null,"stage":null},"printings":[{"pack":"WaR","number":24,"hobSlug":"The-Burglar's-Turn-WaR","octgnGuid":"e91aae6d-3708-4580-8598-9ccceb213839","imageUrls":["https://s3.amazonaws.com/hallofbeorn-resources/Images/Cards/Wrath-and-Ruin/The-Burglar's-Turn-SideA.jpg"]}]},
