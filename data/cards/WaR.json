  {"code":"22026","name":"Drive them Out","type":"quest","typeName":"Quest","sphere":null,"traits":[],"isUnique":false,"cost":null,"deckLimit":null,"threat":null,"willpower":null,"attack":null,"defense":null,"health":null,"questPoints":12,"victory":null,"engagementCost":null,"quantity":1,"easyQuantity":0,"encounterSet":"Wrath and Ruin","stage":"2A","keywords":{},"timings":["whenRevealed","constant","constant","forced","constant"],"text":"When Revealed: Each player returns the highest Threat location he controls to the staging area. Shuffle the encounter discard pile into the encounter deck. Starting with the first player, each player discards cards from the top of the encounter deck until he discards an enemy and puts that enemy into play engaged with him.","shadowText":null,"campaignKind":null,"burdenSet":null,"backType":null,"hasErrata":false,"errata":null,"imagesrc":null,"deckLegal":false,"back":{"name":null,"text":"Progress cannot be placed on locations in the staging area by player card effects.\nThe players cannot travel to Gate of Dorwinion unless there are more locations under the players control than in the staging area.\nForced: When a location is explored, the first player takes control of it.\nAt the end of the round, if the players control Gate of Dorwinion, they win the game.","questPoints":12,"stage":"2B"},"printings":[{"pack":"WaR","number":26,"hobSlug":"Drive-them-Out-WaR","octgnGuid":"138ee2a3-0982-48ab-945e-60fab6f06586","imageUrls":["https://dragncards-lotrlcg.s3.amazonaws.com/cards/English/138ee2a3-0982-48ab-945e-60fab6f06586.B.jpg","https://s3.amazonaws.com/hallofbeorn-resources/Images/Cards/Wrath-and-Ruin/Drive-them-Out-2A.jpg","https://s3.amazonaws.com/hallofbeorn-resources/Images/Cards/Wrath-and-Ruin/Drive-them-Out-2B.jpg"]}]}
